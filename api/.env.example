# Basic config
APP_ENV=development
APP_NAME=artisancode-backend-ts
APP_VERSION=1.0.0
APP_LOG_LEVEL=info
# winston or pino
APP_LOGGER=winston

REST_PORT=3002

# CORS
# Comma-separated list of allowed Origins (scheme + host + port).
# - Development: if empty, all browser origins are allowed (reflected by the server).
# - Production: if empty, browser requests are blocked unless Origin is absent (server-to-server).
# Example: CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=
# If true, allows sending cookies/authorization headers cross-origin.
CORS_ALLOW_CREDENTIALS=true

# Database
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=an_api_key"
# Unpooled connection, used by the WhatsApp queue (BullMQ pins search_path via a
# startup parameter, which pooled endpoints like Neon's pgbouncer reject).
# Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_CONN_TIMEOUT_MS=2000
DB_SSL_ENABLED=true
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# OpenTelemetry
# Toggle OpenTelemetry on/off
OTEL_ENABLED=false
# Sampling ratio (0-1): 1 = all requests, 0.1 = 10% of requests
OTEL_SAMPLING_RATIO=1
# Base OTLP endpoint (US: https://otlp.nr-data.net, EU: https://otlp.eu01.nr-data.net)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Override traces endpoint (defaults to {ENDPOINT}/v1/traces)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Override logs endpoint (defaults to {ENDPOINT}/v1/logs)
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# Headers (comma-separated, e.g. api-key=<license_key>)
OTEL_EXPORTER_OTLP_HEADERS=
# Max attribute value length (auto-read by OTel SDK, no code config needed)
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4095
# Compression algorithm: gzip or none
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
# Diagnostic log level: all, verbose, debug, info, warn, error, none
OTEL_DIAG_LOG_LEVEL=error

# DOKU Payment Gateway
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PUBLIC_KEY=

# WhatsApp
# Provider: gowa (unofficial multi-device API) or noop (simulates sends, for local dev)
WHATSAPP_PROVIDER=noop
# Random delay range (ms) between messages to reduce ban risk on unofficial API
WHATSAPP_SEND_DELAY_MIN_MS=10000
WHATSAPP_SEND_DELAY_MAX_MS=30000

# Gowa (required when WHATSAPP_PROVIDER=gowa)
GOWA_BASE_URL=
# "user:password" (matches APP_BASIC_AUTH on the gowa server)
GOWA_BASIC_AUTH=
GOWA_DEVICE_ID=

# S3 / object storage
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Override endpoint for S3-compatible providers (e.g. MinIO, R2); leave empty for AWS S3
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

API_BASE_URL=http://localhost:3002/api
